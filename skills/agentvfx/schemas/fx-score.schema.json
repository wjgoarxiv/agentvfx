{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentvfx/fx-score.schema.json",
  "title": "agentvfx FX score",
  "description": "What the model writes to render one 3-5 s clip. Enforced by engine/core/validate.mjs (vfx.mjs validate), which also checks template ids, presets, parameter ranges and bindings against the library.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "template", "durationSec", "seed"],
  "$defs": {
    "layer": {
      "oneOf": [
        { "type": "string", "description": "template id" },
        {
          "type": "object", "additionalProperties": false, "required": ["template"],
          "properties": { "template": { "type": "string" }, "preset": { "type": "string" }, "params": { "type": "object" } }
        }
      ]
    },
    "hex": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }
  },
  "properties": {
    "version": { "const": 1 },
    "template": { "type": "string", "description": "base layer template id (vfx.mjs list)" },
    "preset": { "type": "string" },
    "params": { "type": "object", "description": "input name -> value; overrides the preset" },
    "stack": { "type": "array", "maxItems": 2, "items": { "$ref": "#/$defs/layer" }, "description": "layers drawn on top of the base, each fed the previous layer as inputImage" },
    "input": {
      "type": "object", "additionalProperties": false,
      "properties": { "video": { "type": "string" }, "audio": { "type": "string" }, "startSec": { "type": "number", "minimum": 0 } }
    },
    "durationSec": { "type": "number", "minimum": 3, "maximum": 5 },
    "fps": { "enum": [24, 25, 30, 50, 60], "description": "default: the template's X_AGENTVFX.fps, else 30" },
    "seed": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
    "bindings": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["param", "feature", "gain", "offset"],
        "properties": {
          "param": { "type": "string" },
          "feature": { "type": "string", "description": "rms, peak, rmsDb, bass, mid, treb, bass_att, mid_att, treb_att, flux, onset, beat, beatPhase, bpm, corr, width, balance, or bands.0..bands.31" },
          "gain": { "type": "number" }, "offset": { "type": "number" },
          "attackMs": { "type": "number", "minimum": 0 }, "releaseMs": { "type": "number", "minimum": 0 }
        }
      }
    },
    "hits": {
      "type": "array",
      "items": {
        "type": "object", "required": ["template", "durationFrames"],
        "description": "exactly one of t (seconds), onset (onset index), beat (beat index)",
        "properties": {
          "t": { "type": "number", "minimum": 0 }, "onset": { "type": "integer", "minimum": 0 }, "beat": { "type": "integer", "minimum": 0 },
          "template": { "type": "string" }, "preset": { "type": "string" }, "params": { "type": "object" },
          "durationFrames": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "cuts": {
      "type": "array",
      "items": {
        "type": "object", "required": ["layers"],
        "description": "hard cut: exactly one of t (seconds) or beat (beat index); the layers replace the base stack from that frame",
        "properties": {
          "t": { "type": "number", "minimum": 0 }, "beat": { "type": "integer", "minimum": 0 },
          "layers": { "type": "array", "minItems": 1, "maxItems": 3, "items": { "$ref": "#/$defs/layer" } }
        }
      }
    },
    "palette": {
      "oneOf": [
        { "enum": ["brutal-acid", "brutal-red", "mono", "rainbow", "thermal", "paper-grey", "acid-data", "hazard-orange", "flesh-pink", "lilac-terminal", "blood-red", "clinic-mint"] },
        { "type": "array", "minItems": 2, "maxItems": 8, "items": { "$ref": "#/$defs/hex" } }
      ]
    },
    "safety": {
      "type": "object", "additionalProperties": false,
      "description": "default { mode: stage }: full intensity, flash audit written as a report and SAFETY.txt. broadcast-safe enforces limits; safeVariant adds film.safe.mp4 next to the full-intensity film.mp4.",
      "properties": { "mode": { "enum": ["stage", "broadcast-safe"] }, "safeVariant": { "type": "boolean" } }
    },
    "out": { "type": "string", "description": "output folder name" },
    "labels": { "type": "object", "additionalProperties": { "type": "string" }, "description": "text item key -> string, overriding the template's default text" },
    "textStyle": {
      "type": "object",
      "description": "text item key -> look override merged over the template's text item (see references/template-format.md, Text layer)",
      "additionalProperties": {
        "type": "object", "additionalProperties": false,
        "properties": {
          "font": { "enum": ["display", "tall", "grotesk", "mono", "serif"] },
          "size": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
          "x": { "type": "number", "minimum": -0.5, "maximum": 1.5 }, "y": { "type": "number", "minimum": -0.5, "maximum": 1.5 },
          "tracking": { "type": "number", "minimum": -0.2, "maximum": 2 },
          "align": { "enum": ["left", "center", "right"] },
          "weight": { "type": "number", "minimum": 100, "maximum": 900 }
        }
      }
    }
  }
}
