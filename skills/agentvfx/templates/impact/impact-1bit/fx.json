{
  "DESCRIPTION": "Impact frame: the layer below crushes to hard black and white (or a two-colour duotone, optional ordered dither) for 1-3 frames, then dissolves back in chunky blocks",
  "CREDIT": "agentvfx",
  "ISFVSN": "2",
  "CATEGORIES": ["impact"],
  "INPUTS": [
    { "NAME": "hitFrames", "TYPE": "long", "MIN": 1, "MAX": 12, "DEFAULT": 3 },
    { "NAME": "holdFrames", "TYPE": "long", "MIN": 0, "MAX": 6, "DEFAULT": 2 },
    { "NAME": "decayCurve", "TYPE": "float", "MIN": 0.3, "MAX": 4, "DEFAULT": 1 },
    { "NAME": "threshold", "TYPE": "float", "MIN": 0, "MAX": 1, "DEFAULT": 0.48 },
    { "NAME": "preContrast", "TYPE": "float", "MIN": 0.5, "MAX": 5, "DEFAULT": 1.6 },
    { "NAME": "adapt", "TYPE": "float", "MIN": 0, "MAX": 1, "DEFAULT": 0.5 },
    { "NAME": "adaptRadius", "TYPE": "float", "MIN": 1, "MAX": 40, "DEFAULT": 14 },
    { "NAME": "dither", "TYPE": "long", "MIN": 0, "MAX": 2, "VALUES": [0, 1, 2], "LABELS": ["hard", "bayer 8x8", "noise"], "DEFAULT": 0 },
    { "NAME": "ditherAmount", "TYPE": "float", "MIN": 0, "MAX": 1, "DEFAULT": 0.35 },
    { "NAME": "ditherPx", "TYPE": "float", "MIN": 1, "MAX": 12, "DEFAULT": 3 },
    { "NAME": "inkColor", "TYPE": "color", "DEFAULT": [0, 0, 0, 1] },
    { "NAME": "paperColor", "TYPE": "color", "DEFAULT": [1, 1, 1, 1] },
    { "NAME": "useScorePalette", "TYPE": "bool", "DEFAULT": false },
    { "NAME": "flip", "TYPE": "bool", "DEFAULT": false },
    { "NAME": "blockPx", "TYPE": "float", "MIN": 2, "MAX": 160, "DEFAULT": 40 }
  ],
  "X_AGENTVFX": {
    "id": "impact-1bit",
    "family": "impact",
    "input": "either",
    "spdx": "LicenseRef-agentvfx",
    "flash": "possible",
    "fps": 30,
    "palette": true,
    "presets": {
      "onebit-hard": { "hitFrames": 2, "holdFrames": 2, "threshold": 0.48, "preContrast": 1.8 },
      "onebit-bayer": { "hitFrames": 3, "holdFrames": 2, "dither": 1, "ditherAmount": 0.45, "ditherPx": 3, "adapt": 0.25 },
      "onebit-flip": { "hitFrames": 3, "holdFrames": 2, "flip": true, "adapt": 0.7, "preContrast": 2.2 },
      "onebit-duotone": { "hitFrames": 4, "holdFrames": 2, "useScorePalette": true, "dither": 1, "ditherAmount": 0.3 },
      "onebit-blood": { "hitFrames": 3, "holdFrames": 2, "inkColor": [0.02, 0, 0, 1], "paperColor": [0.9, 0.02, 0.02, 1], "adapt": 0.6 }
    },
    "safeSubstitute": { "template": "punch-shake" },
    "credits": [
      "Impact-frame grammar (1-bit black/white on contact), Roblox DevForum VFX notes and sakugabooru wiki",
      "Bayer ordered dither, https://en.wikipedia.org/wiki/Ordered_dithering",
      "Local-mean adaptive threshold, https://en.wikipedia.org/wiki/Thresholding_(image_processing)"
    ]
  }
}
