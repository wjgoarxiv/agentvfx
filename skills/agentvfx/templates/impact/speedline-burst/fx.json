{
  "DESCRIPTION": "Speed-line burst: hard radial wedge lines from a centre over a darkened, zoom-smeared frame, with a hot core; lines re-roll every frame and thin out as the hit decays",
  "CREDIT": "agentvfx",
  "ISFVSN": "2",
  "CATEGORIES": ["impact"],
