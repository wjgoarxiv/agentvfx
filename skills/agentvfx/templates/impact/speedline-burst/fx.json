    { "NAME": "decayCurve", "TYPE": "float", "MIN": 0.3, "MAX": 4, "DEFAULT": 1 },
    { "NAME": "center", "TYPE": "point2D", "DEFAULT": [0.5, 0.5] },
    { "NAME": "lines", "TYPE": "long", "MIN": 8, "MAX": 400, "DEFAULT": 150 },
    { "NAME": "density", "TYPE": "float", "MIN": 0, "MAX": 1, "DEFAULT": 0.6 },
    { "NAME": "thickness", "TYPE": "float", "MIN": 0.05, "MAX": 0.9, "DEFAULT": 0.42 },
