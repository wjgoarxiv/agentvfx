{
  "DESCRIPTION": "Horizontal anamorphic highlight streak: threshold, then three Kawase passes in one direction",
  "CREDIT": "agentvfx",
  "ISFVSN": "2",
  "CATEGORIES": ["light"],
  "INPUTS": [
    { "NAME": "threshold", "TYPE": "float", "MIN": 0, "MAX": 1, "DEFAULT": 0.72 },
    { "NAME": "knee", "TYPE": "float", "MIN": 0, "MAX": 1, "DEFAULT": 0.12 },
    { "NAME": "streakScale", "TYPE": "float", "MIN": 0.2, "MAX": 3, "DEFAULT": 1.5 },
    { "NAME": "streakFalloff", "TYPE": "float", "MIN": 0.8, "MAX": 0.999, "DEFAULT": 0.9 },
    { "NAME": "streakAngle", "TYPE": "float", "MIN": -3.1416, "MAX": 3.1416, "DEFAULT": 0 },
    { "NAME": "streakMix", "TYPE": "float", "MIN": 0, "MAX": 3, "DEFAULT": 1.7 },
    { "NAME": "streakGain", "TYPE": "float", "MIN": 0.5, "MAX": 8, "DEFAULT": 2.6 },
    { "NAME": "dashAmt", "TYPE": "float", "MIN": 0, "MAX": 1, "DEFAULT": 0 },
    { "NAME": "paletteMix", "TYPE": "float", "MIN": 0, "MAX": 1, "DEFAULT": 0.35 },
    { "NAME": "tint", "TYPE": "color", "DEFAULT": [0.35, 0.78, 1, 1] },
    { "NAME": "toneMap", "TYPE": "long", "MIN": 0, "MAX": 1, "VALUES": [0, 1], "LABELS": ["AgX", "ACES"], "DEFAULT": 1 }
  ],
  "PASSES": [
    { "TARGET": "hi", "FLOAT": true },
    { "TARGET": "s0", "FLOAT": true },
    { "TARGET": "s1", "FLOAT": true },
    { "TARGET": "s2", "FLOAT": true },
    {}
  ],
  "X_AGENTVFX": {
    "id": "anamorphic-streak",
    "family": "light",
    "input": "either",
    "spdx": "Apache-2.0",
    "flash": "none",
    "fps": 30,
    "palette": true,
    "presets": {
      "anamorphic-cinema": { "streakAngle": 0, "streakScale": 1.35, "streakFalloff": 0.9, "threshold": 0.72, "knee": 0.1, "streakMix": 1.7, "streakGain": 3.4, "tint": [0.25, 0.82, 1, 1], "paletteMix": 0.2, "toneMap": 1 },
      "vertical-cross": { "streakAngle": 1.5708, "streakScale": 0.85, "streakFalloff": 0.86, "threshold": 0.74, "knee": 0.1, "streakMix": 1.4, "paletteMix": 0.7, "toneMap": 1 },
      "blue-slash": { "streakAngle": 0.28, "streakScale": 1.2, "streakFalloff": 0.88, "threshold": 0.7, "knee": 0.1, "streakMix": 1.8, "tint": [0.2, 0.7, 1, 1], "paletteMix": 0.15, "toneMap": 1 },
      "data-flight": { "dashAmt": 1, "streakAngle": 0, "streakScale": 1.6, "streakFalloff": 0.93, "threshold": 0.78, "knee": 0.08, "streakMix": 1.5, "streakGain": 3.2, "paletteMix": 1, "toneMap": 1 }
    },
    "credits": [
      "Kawase streak: stride 4^(p-1), weight a^(stride*j), about three passes, one direction, at quarter-res spacing",
      "dual Kawase blur family, Masaki Kawase, GDC 2003; summary https://www.intel.com/content/www/us/en/developer/articles/technical/an-investigation-of-fast-real-time-gpu-based-image-blur-algorithms.html",
      "ACES fitted tone map, Krzysztof Narkowicz, https://knarkowicz.wordpress.com/2016/01/06/aces-filmic-tone-mapping-curve/",
      "AgX display fit, Troy Sobotka, https://github.com/sobotka/AgX"
    ]
  }
}
