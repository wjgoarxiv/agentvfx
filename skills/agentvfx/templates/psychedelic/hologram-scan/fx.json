{
  "DESCRIPTION": "Hologram scan: Sobel edge neon over dimmed footage with scanlines, sweep bar, wobble, fringe, flicker and grain",
  "CREDIT": "agentvfx",
  "ISFVSN": "2",
  "CATEGORIES": ["psychedelic"],
  "INPUTS": [
    { "NAME": "neon", "TYPE": "color", "DEFAULT": [0.1, 0.9, 1, 1] },
    { "NAME": "edgeGain", "TYPE": "float", "MIN": 0, "MAX": 8, "DEFAULT": 3.5 },
    { "NAME": "fillLevel", "TYPE": "float", "MIN": 0, "MAX": 1, "DEFAULT": 0.45 },
    { "NAME": "scanScale", "TYPE": "float", "MIN": 10, "MAX": 400, "DEFAULT": 130 },
    { "NAME": "sweepSpeed", "TYPE": "float", "MIN": 0, "MAX": 3, "DEFAULT": 0.8 },
    { "NAME": "wobble", "TYPE": "float", "MIN": 0, "MAX": 0.05, "DEFAULT": 0.012 },
    { "NAME": "fringe", "TYPE": "float", "MIN": 0, "MAX": 12, "DEFAULT": 2.5 },
    { "NAME": "flicker", "TYPE": "float", "MIN": 0, "MAX": 1, "DEFAULT": 0.5 },
    { "NAME": "grain", "TYPE": "float", "MIN": 0, "MAX": 0.5, "DEFAULT": 0.12 },
    { "NAME": "blend", "TYPE": "float", "MIN": 0, "MAX": 1, "DEFAULT": 1 }
  ],
  "X_AGENTVFX": {
    "id": "hologram-scan",
    "family": "psychedelic",
    "input": "footage",
    "spdx": "Apache-2.0",
    "flash": "possible",
    "fps": 30,
    "palette": true,
    "presets": {
      "holo-cyan": { "neon": [0.1, 0.9, 1, 1], "edgeGain": 3.5, "flicker": 0.5, "fringe": 2.5 },
      "holo-magenta": { "neon": [1, 0.15, 0.85, 1], "edgeGain": 4, "fillLevel": 0.4, "flicker": 0.6, "sweepSpeed": 1.1 },
      "holo-storm": { "neon": [0.6, 1, 0.3, 1], "edgeGain": 5, "fillLevel": 0.5, "flicker": 0.85, "wobble": 0.025, "grain": 0.2 }
    },
    "safeSubstitute": { "params": { "flicker": 0, "grain": 0.05 } },
    "credits": [
      "Sobel operator, https://en.wikipedia.org/wiki/Sobel_operator"
    ]
  }
}
