{
  "DESCRIPTION": "Kaleido fold: mirror-folded footage through a spinning segment kaleidoscope with zooming feedback trails",
  "CREDIT": "agentvfx",
  "ISFVSN": "2",
  "CATEGORIES": ["psychedelic"],
  "INPUTS": [
    { "NAME": "segments", "TYPE": "long", "MIN": 2, "MAX": 16, "DEFAULT": 8 },
    { "NAME": "zoom", "TYPE": "float", "MIN": 1, "MAX": 1.1, "DEFAULT": 1.01 },
    { "NAME": "spin", "TYPE": "float", "MIN": -2, "MAX": 2, "DEFAULT": 0.3 },
    { "NAME": "hueSpin", "TYPE": "float", "MIN": 0, "MAX": 10, "DEFAULT": 2 },
    { "NAME": "feedback", "TYPE": "float", "MIN": 0, "MAX": 0.99, "DEFAULT": 0.9 },
    { "NAME": "saturation", "TYPE": "float", "MIN": 0, "MAX": 3, "DEFAULT": 1.7 },
    { "NAME": "blend", "TYPE": "float", "MIN": 0, "MAX": 1, "DEFAULT": 1 }
  ],
  "PASSES": [
    { "TARGET": "fold", "PERSISTENT": true, "FLOAT": true },
    {}
  ],
  "X_AGENTVFX": {
    "id": "kaleido-fold",
    "family": "psychedelic",
    "input": "either",
    "spdx": "Apache-2.0",
    "flash": "none",
    "fps": 30,
    "palette": true,
    "presets": {
      "kaleido-six": { "segments": 6, "zoom": 1.012, "spin": 0.35, "hueSpin": 2, "feedback": 0.78, "saturation": 1.9 },
      "kaleido-twelve": { "segments": 12, "zoom": 1.02, "spin": 0.6, "hueSpin": 3.5, "feedback": 0.93, "saturation": 1.9 },
      "kaleido-mirror": { "segments": 8, "zoom": 1.005, "spin": 0.15, "hueSpin": 1, "feedback": 0.86, "saturation": 1.6 }
    },
    "credits": [
      "iq cosine palette, https://iquilezles.org/articles/palettes/",
      "fbm, The Book of Shaders ch.13, https://thebookofshaders.com/13/"
    ]
  }
}
