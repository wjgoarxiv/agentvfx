{
  "DESCRIPTION": "Triggered oscilloscope in the manner of Wave Candy: sync-locked stereo traces with window, pinch, interpolation and L/R separation over a brutalist graticule. HUD instrument look: thin lines in a bracketed panel, dashed grid, tick rulers with numerals, readouts, field-colour variants. HUD instrument look: thin lines in a bracketed panel, dashed grid, tick rulers with numerals, readouts, field-colour variants. HUD instrument look: thin lines in a bracketed panel, dashed grid, tick rulers with numerals, readouts, field-colour variants. HUD instrument look: thin lines in a bracketed panel, dashed grid, tick rulers with numerals, readouts, field-colour variants. HUD instrument look: thin lines in a bracketed panel, dashed grid, tick rulers with numerals, readouts, field-colour variants",
  "CREDIT": "agentvfx",
  "ISFVSN": "2",
  "CATEGORIES": [
    "scope",
    "audio"
  ],
  "INPUTS": [
    {
      "NAME": "fieldMode",
      "TYPE": "long",
      "MIN": 0,
      "MAX": 4,
      "VALUES": [
        0,
        1,
        2,
        3,
        4
      ],
      "LABELS": [
        "black ground, off-white lines",
        "acid lime field, black lines",
        "ultramarine field, white lines",
        "phosphor green on black",
        "signal orange field, blue lines"
      ],
      "DEFAULT": 0
    },
    {
      "NAME": "window",
      "TYPE": "long",
      "MIN": 16,
      "MAX": 512,
      "DEFAULT": 320
    },
    {
      "NAME": "syncMode",
      "TYPE": "long",
      "MIN": 0,
      "MAX": 3,
      "VALUES": [
        0,
        1,
        2,
        3
      ],
      "LABELS": [
        "free run",
        "rising zero crossing",
        "level trigger",
        "period lock"
      ],
      "DEFAULT": 1
    },
    {
      "NAME": "syncLevel",
      "TYPE": "float",
      "MIN": -0.8,
      "MAX": 0.8,
      "DEFAULT": 0
    },
    {
      "NAME": "syncHz",
      "TYPE": "float",
      "MIN": 20,
      "MAX": 2000,
      "DEFAULT": 100
    },
    {
      "NAME": "syncCycles",
      "TYPE": "long",
      "MIN": 1,
      "MAX": 8,
      "DEFAULT": 2
    },
    {
      "NAME": "pinch",
      "TYPE": "float",
      "MIN": 0,
      "MAX": 1,
      "DEFAULT": 0.3
    },
    {
      "NAME": "interpolate",
      "TYPE": "long",
      "MIN": 0,
      "MAX": 2,
      "VALUES": [
        0,
        1,
        2
      ],
      "LABELS": [
        "raw steps",
        "linear",
        "band-limited"
      ],
      "DEFAULT": 2
    },
    {
      "NAME": "stereoSeparation",
      "TYPE": "float",
      "MIN": 0,
      "MAX": 0.5,
      "DEFAULT": 0.22
    },
    {
      "NAME": "amplitude",
      "TYPE": "float",
      "MIN": 0.2,
      "MAX": 10,
      "DEFAULT": 2.2
    },
    {
      "NAME": "thickness",
      "TYPE": "float",
      "MIN": 0.6,
      "MAX": 14,
      "DEFAULT": 1.7
    },
    {
      "NAME": "speedDim",
      "TYPE": "float",
      "MIN": 0,
      "MAX": 1,
      "DEFAULT": 0.2
    },
    {
      "NAME": "fill",
      "TYPE": "float",
      "MIN": 0,
      "MAX": 1,
      "DEFAULT": 0
    },
    {
      "NAME": "persist",
      "TYPE": "float",
      "MIN": 0,
      "MAX": 0.97,
      "DEFAULT": 0.45
    },
    {
      "NAME": "bloom",
      "TYPE": "float",
      "MIN": 0,
      "MAX": 4,
      "DEFAULT": 0.3
    },
    {
      "NAME": "bloomSize",
      "TYPE": "float",
      "MIN": 0.4,
      "MAX": 2,
      "DEFAULT": 1
    },
    {
      "NAME": "exposure",
      "TYPE": "float",
      "MIN": 0.2,
      "MAX": 8,
      "DEFAULT": 1
    },
    {
      "NAME": "hot",
      "TYPE": "float",
      "MIN": 0,
      "MAX": 1,
      "DEFAULT": 0
    },
    {
      "NAME": "hud",
      "TYPE": "float",
      "MIN": 0,
      "MAX": 1,
      "DEFAULT": 1
    },
    {
      "NAME": "audioKick",
      "TYPE": "float",
      "MIN": 0,
      "MAX": 2,
      "DEFAULT": 0.25
    }
  ],
  "PASSES": [
    {
      "TARGET": "curve",
      "FLOAT": true
    },
    {
      "TARGET": "beam",
      "PERSISTENT": true,
      "FLOAT": true
    },
