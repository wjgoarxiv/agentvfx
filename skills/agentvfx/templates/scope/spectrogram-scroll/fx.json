{
  "DESCRIPTION": "Scrolling log-frequency spectrogram as hard pixel blocks: dB range, colour map, onset ticks, octave grid and a playhead. HUD instrument look: thin lines in a bracketed panel, dashed grid, tick rulers with numerals, readouts, field-colour variants. HUD instrument look: thin lines in a bracketed panel, dashed grid, tick rulers with numerals, readouts, field-colour variants. HUD instrument look: thin lines in a bracketed panel, dashed grid, tick rulers with numerals, readouts, field-colour variants. HUD instrument look: thin lines in a bracketed panel, dashed grid, tick rulers with numerals, readouts, field-colour variants. HUD instrument look: thin lines in a bracketed panel, dashed grid, tick rulers with numerals, readouts, field-colour variants",
  "CREDIT": "agentvfx",
  "ISFVSN": "2",
  "CATEGORIES": [
    "scope",
    "audio"
  ],
  "INPUTS": [
    {
      "NAME": "fieldMode",
      "TYPE": "long",
      "MIN": 0,
      "MAX": 4,
      "VALUES": [
        0,
        1,
        2,
        3,
        4
      ],
      "LABELS": [
        "black ground, off-white lines",
        "acid lime field, black lines",
        "ultramarine field, white lines",
        "phosphor green on black",
        "signal orange field, blue lines"
      ],
      "DEFAULT": 0
    },
    {
      "NAME": "fMin",
      "TYPE": "float",
      "MIN": 20,
      "MAX": 2000,
      "DEFAULT": 50
    },
    {
      "NAME": "fMax",
      "TYPE": "float",
      "MIN": 2000,
      "MAX": 24000,
      "DEFAULT": 16000
    },
    {
      "NAME": "freqScale",
      "TYPE": "long",
      "MIN": 0,
      "MAX": 2,
      "VALUES": [
        0,
        1,
        2
      ],
      "LABELS": [
        "log",
        "linear",
        "square root"
      ],
      "DEFAULT": 0
    },
    {
      "NAME": "dbMin",
      "TYPE": "float",
      "MIN": -70,
      "MAX": -20,
      "DEFAULT": -64
    },
    {
      "NAME": "dbMax",
      "TYPE": "float",
      "MIN": -40,
      "MAX": 0,
      "DEFAULT": -26
    },
    {
      "NAME": "tilt",
      "TYPE": "float",
      "MIN": 0,
      "MAX": 9,
      "DEFAULT": 3
    },
    {
      "NAME": "gamma",
      "TYPE": "float",
      "MIN": 0.3,
      "MAX": 3,
      "DEFAULT": 0.85
    },
    {
      "NAME": "colorMap",
      "TYPE": "long",
      "MIN": 0,
      "MAX": 5,
      "VALUES": [
        0,
        1,
        2,
        3,
        4,
        5
      ],
      "LABELS": [
        "acid",
        "heat",
        "ultraviolet",
        "palette",
        "mono",
        "ink halftone"
      ],
      "DEFAULT": 5
    },
    {
      "NAME": "scrollPx",
      "TYPE": "long",
      "MIN": 1,
      "MAX": 32,
      "DEFAULT": 12
    },
    {
      "NAME": "cell",
      "TYPE": "long",
      "MIN": 1,
      "MAX": 32,
      "DEFAULT": 10
    },
    {
      "NAME": "smoothing",
      "TYPE": "float",
      "MIN": 0,
      "MAX": 0.9,
      "DEFAULT": 0.25
    },
    {
      "NAME": "mirror",
      "TYPE": "bool",
      "DEFAULT": false
    },
    {
      "NAME": "onsetTicks",
      "TYPE": "float",
      "MIN": 0,
      "MAX": 1,
      "DEFAULT": 1
    },
    {
      "NAME": "grid",
      "TYPE": "float",
      "MIN": 0,
      "MAX": 1,
      "DEFAULT": 0.6
    },
    {
      "NAME": "playhead",
      "TYPE": "float",
      "MIN": 0,
      "MAX": 1,
      "DEFAULT": 1
    },
    {
      "NAME": "hot",
      "TYPE": "float",
      "MIN": 0,
      "MAX": 1,
      "DEFAULT": 0
    },
    {
      "NAME": "bloom",
      "TYPE": "float",
      "MIN": 0,
      "MAX": 4,
      "DEFAULT": 0.3
    },
    {
      "NAME": "preroll",
      "TYPE": "float",
      "MIN": 0,
      "MAX": 1,
      "DEFAULT": 1
    },
    {
      "NAME": "hud",
      "TYPE": "float",
      "MIN": 0,
      "MAX": 1,
      "DEFAULT": 1
    }
  ],
  "PASSES": [
    {
      "TARGET": "specBuf",
      "PERSISTENT": true,
      "FLOAT": true
    },
    {
      "TARGET": "hudMask",
      "FLOAT": true
    },
    {}
  ],
  "X_AGENTVFX": {
    "id": "spectrogram-scroll",
    "family": "scope",
    "input": "either",
    "spdx": "LicenseRef-agentvfx",
    "flash": "none",
    "fps": 60,
    "palette": false,
    "presets": {
      "hud-black": {
        "fieldMode": 0,
        "colorMap": 5,
        "scrollPx": 12,
        "cell": 12,
        "smoothing": 0.25
      },
      "field-lime": {
        "fieldMode": 1,
        "colorMap": 5,
        "scrollPx": 12,
        "cell": 8,
        "smoothing": 0.35,
        "tilt": 4.5,
        "gamma": 1.3
      },
      "field-ultramarine": {
        "fieldMode": 2,
        "colorMap": 5,
        "mirror": true,
        "scrollPx": 12,
        "cell": 8,
        "smoothing": 0.2
      },
      "boot-green": {
        "fieldMode": 3,
        "colorMap": 5,
        "scrollPx": 8,
        "cell": 6,
        "smoothing": 0.4,
        "freqScale": 2,
        "fMin": 30
      },
      "glow-phosphor": {
        "fieldMode": 3,
        "colorMap": 0,
        "scrollPx": 12,
        "cell": 10,
        "smoothing": 0.25,
        "hud": 0.5
      }
    },
    "audioBind": {
      "dbMax": "rms"
    },
    "credits": [
