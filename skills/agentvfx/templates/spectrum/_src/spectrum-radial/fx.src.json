{
  "DESCRIPTION": "Starburst instrument: mirrored hairline spectrum spokes with tip dots, echo ghosts, tick ring, dashed outer circle and a bracketed frame; the ring snaps on strong onsets",
  "CREDIT": "agentvfx",
  "ISFVSN": "2",
  "CATEGORIES": ["spectrum", "audio", "hud"],
  "INPUTS": [
    { "NAME": "bandCount", "TYPE": "long", "MIN": 8, "MAX": 120, "DEFAULT": 64 },
    { "NAME": "maxHeight", "TYPE": "float", "MIN": 0.05, "MAX": 1, "DEFAULT": 1 },
    { "NAME": "displayMode", "TYPE": "long", "MIN": 0, "MAX": 2, "VALUES": [0, 1, 2], "LABELS": ["hairline", "stepped", "dots"], "DEFAULT": 0 },
    { "NAME": "side", "TYPE": "long", "MIN": 0, "MAX": 1, "VALUES": [0, 1], "LABELS": ["outward", "inward"], "DEFAULT": 0 },
    { "NAME": "lobes", "TYPE": "long", "MIN": 1, "MAX": 8, "DEFAULT": 2 },
    { "NAME": "echoLayers", "TYPE": "long", "MIN": 0, "MAX": 6, "DEFAULT": 3 },
    { "NAME": "echoDelay", "TYPE": "long", "MIN": 1, "MAX": 4, "DEFAULT": 2 },
    { "NAME": "innerRadius", "TYPE": "float", "MIN": 0.06, "MAX": 0.4, "DEFAULT": 0.12 },
    { "NAME": "spin", "TYPE": "float", "MIN": -6, "MAX": 6, "DEFAULT": 0.12 },
    { "NAME": "snapDeg", "TYPE": "float", "MIN": 0, "MAX": 90, "DEFAULT": 9 },
    { "NAME": "pulse", "TYPE": "float", "MIN": 0, "MAX": 0.5, "DEFAULT": 0.08 },
    { "NAME": "tickCount", "TYPE": "float", "MIN": 12, "MAX": 360, "DEFAULT": 120 },
    { "NAME": "floorHeight", "TYPE": "float", "MIN": 0, "MAX": 10, "DEFAULT": 3 }
  ],
  "use": ["pro", "stage", "hud"],
  "defaults": { "startFreq": 25, "endFreq": 9000, "freqCurve": 2.3 },
  "PASSES": [
    { "TARGET": "barState", "PERSISTENT": true, "FLOAT": true },
    {}
  ],
  "X_AGENTVFX": {
    "id": "spectrum-radial",
    "family": "spectrum",
    "input": "either",
    "spdx": "LicenseRef-agentvfx",
    "flash": "possible",
    "fps": 30,
    "palette": true,
    "presets": {
      "starburst-black": {},
      "starburst-ultramarine": { "$field": "ultramarine", "displayMode": 1 },
      "starburst-acid": { "$field": "acid", "lobes": 3, "bandCount": 48 },
      "dots-orange": { "$field": "orange", "displayMode": 2, "bandCount": 40 },
      "rainbow-glow": { "colorMode": 1, "glow": 1.4, "lineWidth": 2.4 }
    },
    "audioBind": { "pulse": "onset" },
    "safeSubstitute": { "params": { "pulse": 0, "snapDeg": 0, "kickZoom": 0, "shake": 0 } },
    "text": [
      { "key": "title", "default": "RADIAL", "x": 0.03, "y": 0.06, "size": 0.07, "font": "display", "style": "outline", "box": "tab" },
      { "key": "node", "default": "NODE 7G-75", "x": 0.97, "y": 0.045, "size": 0.085, "font": "tall", "align": "right" },
      { "key": "log", "default": "SIG 04 // 25-9000HZ\nRING LOCK  0x04F2\nCACHE OK", "x": 0.03, "y": 0.8, "size": 0.017, "font": "mono", "reveal": "type", "revealStart": 0.2, "revealDur": 1.5 },
      { "key": "num", "default": "KX  7G2  R4  D9\n41A TQP  118  3", "x": 0.97, "y": 0.9, "size": 0.016, "font": "mono", "align": "right" }
    ],
    "credits": [
      "Starburst glyph and bracketed frame grammar: original drawing, no marks, fonts or text from other works",
      "After Effects Audio Spectrum polar path vocabulary, https://helpx.adobe.com/after-effects/using/audio-effects.html",
      "Power-curve bin mapping and peak-preserving neighbour smoothing as described for open-source bar-visualiser recreations (algorithm described, no code used)"
    ]
  }
}
